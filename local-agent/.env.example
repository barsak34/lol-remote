# Credenciales de Supabase
# Obtén estos valores en tu dashboard de Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_CHANNEL=lol-commands

# Ruta personalizada opcional del lockfile si League of Legends está instalado en una ruta no estándar
# Por defecto busca en C:\Riot Games\League of Legends\lockfile y E:\Riot Games\League of Legends\lockfile
# LOL_LOCKFILE_PATH=C:\Riot Games\League of Legends\lockfile
